DATABASE_URL=postgresql://cafepos:cafepos_local_dev@127.0.0.1:54329/cafepos
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
PORT=4000
HOST=127.0.0.1
APP_ORIGIN=http://127.0.0.1:5173
NODE_ENV=development
BUSINESS_TIMEZONE=Asia/Phnom_Penh
# Generate a P-256 key pair with npm run pos:keygen before enabling signed device catalog bootstrap.
POS_CATALOG_SIGNING_KEY_ID=pos-catalog-v1
POS_CATALOG_SIGNING_PRIVATE_KEY_PATH=.runtime/pos-catalog-v1-private.pem
# On Vercel, set POS_CATALOG_SIGNING_PRIVATE_KEY as a secret instead of using a file path.
POS_CATALOG_LEASE_HOURS=24
VITE_POS_CATALOG_PUBLIC_KEYS={}
POS_TRUST_PROXY_HOPS=0
# Used only by npm run db:local. Use a standard PostgreSQL server in production.
LOCAL_PG_PORT=54329
LOCAL_PG_USER=cafepos
LOCAL_PG_PASSWORD=cafepos_local_dev
